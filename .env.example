POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos
REDIS_URL=redis://localhost:6379/0
# LLM provider (fill in later, Milestone 1)

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://localhost:11434
# For hosted providers set LLM_PROVIDER=openai_compatible and fill these in:
OPENAI_BASE_URL=
OPENAI_API_KEY=
TAVILY_API_KEY=
# Where agent-written code runs. 'docker' = isolated container (run `make sandbox` once).
# 'local' = a plain subprocess on this machine with NO isolation. Only if you accept that.
CODE_EXEC_BACKEND=docker
CODE_EXEC_IMAGE=python:3.12-slim
# Browser origins allowed to call the API, comma separated (the dashboard's address).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
