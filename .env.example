POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos
POSTGRES_DB=agentos
DATABASE_URL=postgresql://agentos:agentos@localhost:5432/agentos
REDIS_URL=redis://localhost:6379/0
# LLM provider (fill in later, Milestone 1)

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://localhost:11434
# For hosted providers set LLM_PROVIDER=openai_compatible and fill these in:
OPENAI_BASE_URL=
OPENAI_API_KEY=
TAVILY_API_KEY=
# Where agent-written code runs. 'docker' = isolated container (run `make sandbox` once).
# 'local' = a plain subprocess on this machine with NO isolation. Only if you accept that.
CODE_EXEC_BACKEND=docker
CODE_EXEC_IMAGE=python:3.12-slim
# Browser origins allowed to call the API, comma separated (the dashboard's address).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Deployment (docker-compose.prod.yml; see docs/DEPLOY.md) ----
# Only needed for the full-stack containers. `make up` + local processes ignore these.
# Address people use. Local try-out: http://localhost:8080. Real host: https://agentos.example.com
PUBLIC_URL=http://localhost:8080
# ":80" = plain http. A domain name = Caddy gets and renews a TLS certificate by itself.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Starting and cancelling missions needs this login (the API has no auth yet, milestone M5).
# Make the hash with `make hash-password`, and keep the single quotes: the hash contains "$".
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=''
# Group id of the docker socket on the host: `stat -c %g /var/run/docker.sock`
DOCKER_GID=999
WORKER_CONCURRENCY=1

# ---- Reliability (see docs/RELIABILITY.md) ----
# A worker silent for TASK_LEASE_SECONDS is presumed dead and its task is retried. The heartbeat
# must be at most half the lease (checked at startup). Defaults shown.
# TASK_LEASE_SECONDS=30
# LEASE_HEARTBEAT_SECONDS=10
# REAPER_INTERVAL_SECONDS=10
# A failed attempt that is worth retrying waits min(RETRY_MAX, RETRY_BASE * 2^(n-1)) seconds (half random).
# RETRY_BASE_SECONDS=2
# RETRY_MAX_SECONDS=60
# SWEEP_INTERVAL_SECONDS=2
# READY_REPUBLISH_SECONDS=60
# Every agent's timeout_seconds is enforced, times this factor. Raise it for a slow local model.
# TASK_TIMEOUT_SCALE=1.0
